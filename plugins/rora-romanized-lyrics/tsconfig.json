{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"src/lyrics/**/*.ts",
		"src/playback/**/*.ts",
		"src/providers/tidalPayload.ts",
		"src/settings/numeric.ts",
		"src/types/**/*.ts",
		"test/**/*.ts"
	]
}
